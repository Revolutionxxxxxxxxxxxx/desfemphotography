* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --black: #000000;
    --white: #ffffff;
    --off-white: #f0f0f0;
    --gray: #888888;
    --dark-gray: #1a1a1a;
    --accent: #c8c8c8;
    --glass-bg: rgba(255, 255, 255, 0.06);
    --glass-border: rgba(255, 255, 255, 0.12);
    --glass-highlight: rgba(255, 255, 255, 0.18);
    --glass-blur: 24px;
}

html { 
    scroll-behavior: smooth; 
}

body {
    background-color: var(--black);
    color: var(--white);
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
    position: relative;
    line-height: 1.6;
}

/* Full-page Background Image */
.bg-image {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    background-image: url('https://images.unsplash.com/photo-1500043357865-c6b8827edf10?w=1920&q=80');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    filter: brightness(0.35) saturate(0.8);
}

.bg-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.8) 100%);
}

/* Grain Overlay */
.grain {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 200px;
}

/* ============================================
   NAVIGATION - Enhanced
   ============================================ */
nav {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 40px);
    max-width: 1400px;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 1000;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(30px) saturate(200%);
    -webkit-backdrop-filter: blur(30px) saturate(200%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.2),
        inset 0 -1px 0 rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
}

/* Logo - Image Based */
.logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: all 0.3s ease;
}

.logo:hover {
    opacity: 0.85;
    transform: scale(1.02);
}

.logo img {
    height: 45px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
}

.nav-links {
    display: flex;
    gap: 40px;
    list-style: none;
}

.nav-links a {
    color: var(--white);
    text-decoration: none;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    position: relative;
    transition: all 0.3s ease;
    padding: 8px 0;
}

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 1px;
    background: var(--white);
    transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.nav-links a:hover::after {
    width: 100%;
}

.nav-links a:hover {
    color: var(--white);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
}

/* Mobile Menu Toggle */
.menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    padding: 10px;
    z-index: 1001;
    border-radius: 8px;
    transition: background 0.3s ease;
}

.menu-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
}

.menu-toggle span {
    width: 26px;
    height: 2px;
    background: var(--white);
    transition: all 0.3s ease;
    border-radius: 2px;
}

.menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(6px, 6px);
}

.menu-toggle.active span:nth-child(2) {
    opacity: 0;
    transform: translateX(-10px);
}

.menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
}

/* ============================================
   HERO SECTION - Enhanced
   ============================================ */
.hero {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 0 50px;
}

.hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(60px, 12vw, 180px);
    font-weight: 900;
    line-height: 0.9;
    text-align: center;
    letter-spacing: -3px;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    margin-bottom: 20px;
}

.hero-title .italic {
    font-style: italic;
    font-weight: 400;
}

.hero-subtitle {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    letter-spacing: 6px;
    text-transform: uppercase;
    margin-top: 40px;
    color: var(--gray);
    padding: 14px 32px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15);
}

.scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gray);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { 
        opacity: 0.4;
        transform: translateX(-50%) translateY(0);
    }
    50% { 
        opacity: 1;
        transform: translateX(-50%) translateY(-5px);
    }
}

/* ============================================
   MARQUEE - Enhanced
   ============================================ */
.marquee-section {
    padding: 30px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}

.marquee-track {
    display: flex;
    animation: marquee 20s linear infinite;
    width: max-content;
}

.marquee-track span {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-style: italic;
    white-space: nowrap;
    padding: 0 30px;
    color: var(--gray);
}

.marquee-track span.dot {
    color: var(--white);
    font-style: normal;
}

@keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

/* ============================================
   PORTFOLIO SECTION - Enhanced
   ============================================ */
.portfolio {
    padding: 120px 50px;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 80px;
}

.section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.section-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--gray);
    padding: 10px 20px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
}

.portfolio-item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    min-height: 300px;
    transition: all 0.4s ease;
}

.portfolio-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
}

.portfolio-item:nth-child(1) { grid-column: 1 / 7; grid-row: 1 / 3; }
.portfolio-item:nth-child(2) { grid-column: 7 / 13; grid-row: 1 / 2; }
.portfolio-item:nth-child(3) { grid-column: 7 / 10; grid-row: 2 / 3; }
.portfolio-item:nth-child(4) { grid-column: 10 / 13; grid-row: 2 / 4; }
.portfolio-item:nth-child(5) { grid-column: 1 / 5; grid-row: 3 / 4; }
.portfolio-item:nth-child(6) { grid-column: 5 / 10; grid-row: 3 / 5; }

.portfolio-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.6s ease;
    filter: grayscale(100%) contrast(1.1);
}

.portfolio-item:hover img {
    transform: scale(1.08);
    filter: grayscale(0%) contrast(1);
}

.portfolio-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.4s ease;
}

.portfolio-item:hover .portfolio-overlay {
    opacity: 1;
}

.portfolio-overlay h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 5px;
}

.portfolio-overlay p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gray);
}

/* ============================================
   ABOUT SECTION - Enhanced
   ============================================ */
.about {
    padding: 120px 50px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.about-text h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 40px;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.about-text h2 .italic {
    font-style: italic;
    font-weight: 400;
}

.about-text p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--gray);
    margin-bottom: 20px;
    max-width: 500px;
}

.about-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 60px;
}

.stat-item {
    padding: 28px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transition: all 0.3s ease;
}

.stat-item:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 
        0 12px 40px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.stat-item h3 {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    font-weight: 900;
    margin-bottom: 8px;
}

.stat-item p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gray);
    margin: 0;
}

.about-image {
    position: relative;
    height: 600px;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
    transition: all 0.4s ease;
}

.about-image:hover {
    transform: scale(1.02);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
}

.about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
}

/* ============================================
   SERVICES SECTION - Enhanced
   ============================================ */
.services {
    padding: 120px 50px;
}

.services-list {
    margin-top: 80px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.service-item {
    display: grid;
    grid-template-columns: 80px 1fr 200px 40px;
    align-items: center;
    padding: 32px 40px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.12);
    transition: all 0.4s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
}

.service-item:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateX(10px);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 
        0 12px 40px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
}

.service-item:hover .service-arrow {
    transform: translateX(10px);
}

.service-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    color: var(--gray);
    letter-spacing: 2px;
}

.service-name {
    font-family: 'Playfair Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
}

.service-desc {
    font-size: 13px;
    color: var(--gray);
    line-height: 1.6;
}

.service-arrow {
    font-size: 20px;
    transition: transform 0.4s ease;
    text-align: right;
}

/* ============================================
   REVIEWS SECTION - Enhanced
   ============================================ */
.reviews {
    padding: 120px 50px;
}

.reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 80px;
}

.review-card {
    padding: 40px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transition: all 0.3s ease;
}

.review-card:hover {
    transform: translateY(-8px);
    box-shadow: 
        0 16px 48px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.review-stars {
    color: #FFD700;
    font-size: 14px;
    margin-bottom: 20px;
    letter-spacing: 2px;
}

.review-text {
    font-size: 15px;
    line-height: 1.8;
    color: var(--off-white);
    margin-bottom: 24px;
    font-style: italic;
}

.review-author {
    display: flex;
    align-items: center;
    gap: 16px;
}

.review-author-img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.2);
}

.review-author-info h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
}

.review-author-info p {
    font-size: 12px;
    color: var(--gray);
}

/* ============================================
   CONTACT SECTION - Enhanced
   ============================================ */
.contact {
    padding: 120px 50px;
    text-align: center;
}

.contact h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(48px, 8vw, 120px);
    font-weight: 900;
    line-height: 1;
    margin-bottom: 20px;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
}

.contact h2 .italic {
    font-style: italic;
    font-weight: 400;
}

.contact-subtitle {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: 60px;
}

.contact-btn {
    display: inline-block;
    padding: 22px 64px;
    border-radius: 100px;
    color: var(--white);
    text-decoration: none;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.contact-btn:hover {
    background: rgba(255, 255, 255, 0.95);
    color: var(--black);
    border-color: rgba(255, 255, 255, 0.9);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(255, 255, 255, 0.2);
}

.contact-info {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 80px;
    flex-wrap: wrap;
}

.contact-info-item {
    text-align: center;
    padding: 32px 40px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    min-width: 200px;
    transition: all 0.3s ease;
}

.contact-info-item:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.1);
}

.contact-info-item h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: 10px;
}

.contact-info-item p {
    font-size: 14px;
    color: var(--off-white);
}

/* ============================================
   SOCIAL LINKS - Enhanced
   ============================================ */
.social-links {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-top: 60px;
}

.social-link {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transition: all 0.3s ease;
    color: var(--white);
    font-size: 24px;
    text-decoration: none;
}

.social-link:hover {
    transform: translateY(-4px) scale(1.1);
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
}

.social-link.whatsapp:hover {
    background: #25D366;
    border-color: #25D366;
}

.social-link.instagram:hover {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    border-color: transparent;
}

/* ============================================
   FOOTER - Enhanced
   ============================================ */
footer {
    padding: 30px 50px;
    margin: 0 20px 20px;
    border-radius: 100px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

footer p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--gray);
    text-transform: uppercase;
}

.footer-links {
    display: flex;
    gap: 30px;
}

.footer-links a {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--gray);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.3s ease;
}

.footer-links a:hover {
    color: var(--white);
}

/* ============================================
   ANIMATIONS
   ============================================ */
.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

/* ============================================
   📱 MOBILE CSS (up to 480px) - Enhanced
   ============================================ */
@media (max-width: 480px) {
    nav {
        padding: 14px 18px;
        top: 10px;
        width: calc(100% - 20px);
        border-radius: 60px;
    }

    .logo img {
        height: 36px;
    }

    .menu-toggle {
        display: flex;
    }

    .nav-links {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.97);
        backdrop-filter: blur(30px);
        -webkit-backdrop-filter: blur(30px);
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 32px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease;
        z-index: 999;
    }

    .nav-links.open {
        opacity: 1;
        pointer-events: all;
    }

    .nav-links a {
        font-size: 18px;
        letter-spacing: 4px;
    }

    .hero {
        padding: 0 20px;
    }

    .hero-title {
        font-size: clamp(48px, 14vw, 80px);
        letter-spacing: -1px;
    }

    .hero-subtitle {
        font-size: 9px;
        letter-spacing: 3px;
        padding: 10px 20px;
        margin-top: 24px;
        text-align: center;
    }

    .scroll-indicator {
        font-size: 9px;
        bottom: 24px;
    }

    .marquee-track span {
        font-size: 14px;
        padding: 0 16px;
    }

    .portfolio, .about, .services, .reviews, .contact {
        padding: 80px 20px;
    }

    .section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 40px;
    }

    .section-title {
        font-size: clamp(32px, 10vw, 48px);
    }

    .portfolio-grid {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .portfolio-item:nth-child(n) {
        grid-column: 1 / -1;
        grid-row: auto;
        min-height: 280px;
    }

    .portfolio-overlay {
        opacity: 1;
        padding: 20px;
    }

    .portfolio-overlay h3 {
        font-size: 18px;
    }

    .about {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .about-image {
        height: 300px;
    }

    .about-stats {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-top: 40px;
    }

    .stat-item {
        padding: 18px;
    }

    .stat-item h3 {
        font-size: 32px;
    }

    .stat-item p {
        font-size: 9px;
    }

    .service-item {
        grid-template-columns: 1fr;
        gap: 8px;
        padding: 20px;
        border-radius: 16px;
    }

    .service-number {
        font-size: 11px;
    }

    .service-name {
        font-size: 22px;
    }

    .service-desc {
        font-size: 12px;
    }

    .service-arrow {
        display: none;
    }

    .reviews-grid {
        grid-template-columns: 1fr;
        gap: 16px;
        margin-top: 40px;
    }

    .review-card {
        padding: 24px;
        border-radius: 18px;
    }

    .review-text {
        font-size: 14px;
    }

    .contact h2 {
        font-size: clamp(40px, 12vw, 64px);
    }

    .contact-btn {
        padding: 16px 40px;
        font-size: 11px;
        letter-spacing: 2px;
    }

    .contact-info {
        flex-direction: column;
        gap: 12px;
        margin-top: 40px;
    }

    .contact-info-item {
        padding: 20px;
        min-width: auto;
        width: 100%;
    }

    .social-link {
        width: 50px;
        height: 50px;
        font-size: 20px;
    }

    footer {
        flex-direction: column;
        gap: 16px;
        text-align: center;
        padding: 20px;
        border-radius: 24px;
        margin: 0 10px 10px;
    }

    .footer-links {
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
    }
}

/* ============================================
   📱 TABLET CSS (481px - 768px) - Enhanced
   ============================================ */
@media (min-width: 481px) and (max-width: 768px) {
    nav {
        padding: 16px 24px;
        top: 12px;
        width: calc(100% - 24px);
    }

    .logo img {
        height: 40px;
    }

    .menu-toggle {
        display: flex;
    }

    .nav-links {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.97);
        backdrop-filter: blur(30px);
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 32px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease;
        z-index: 999;
    }

    .nav-links.open {
        opacity: 1;
        pointer-events: all;
    }

    .nav-links a {
        font-size: 16px;
        letter-spacing: 3px;
    }

    .hero {
        padding: 0 30px;
    }

    .hero-title {
        font-size: clamp(50px, 10vw, 100px);
    }

    .portfolio, .about, .services, .reviews, .contact {
        padding: 100px 30px;
    }

    .section-header {
        margin-bottom: 50px;
    }

    .section-title {
        font-size: clamp(36px, 6vw, 60px);
    }

    .portfolio-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .portfolio-item:nth-child(n) {
        grid-column: auto;
        grid-row: auto;
        min-height: 240px;
    }

    .portfolio-item:nth-child(1) {
        grid-column: 1 / -1;
        min-height: 320px;
    }

    .portfolio-overlay {
        opacity: 1;
    }

    .about {
        grid-template-columns: 1fr;
        gap: 50px;
    }

    .about-image {
        height: 400px;
    }

    .service-item {
        grid-template-columns: 60px 1fr 30px;
        padding: 24px;
    }

    .service-desc {
        grid-column: 2 / -1;
    }

    .reviews-grid {
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .review-card:last-child {
        grid-column: 1 / -1;
    }

    .contact-info {
        gap: 16px;
    }

    .contact-info-item {
        min-width: 160px;
        padding: 24px;
    }

    footer {
        padding: 24px 30px;
        margin: 0 15px 15px;
        border-radius: 60px;
    }
}

/* ============================================
   📱 iPad Pro / Small Desktop (769px - 1024px) - Enhanced
   ============================================ */
@media (min-width: 769px) and (max-width: 1024px) {
    nav {
        padding: 18px 30px;
    }

    .nav-links {
        gap: 28px;
    }

    .nav-links a {
        font-size: 12px;
        letter-spacing: 2px;
    }

    .hero {
        padding: 0 40px;
    }

    .portfolio, .about, .services, .reviews, .contact {
        padding: 110px 40px;
    }

    .about {
        gap: 50px;
    }

    .about-image {
        height: 500px;
    }

    .service-item {
        grid-template-columns: 60px 1fr 180px 30px;
        padding: 26px 30px;
    }

    .reviews-grid {
        gap: 20px;
    }

    .review-card {
        padding: 32px;
    }
}

/* ============================================
   🖥️ Touch devices - disable hover effects
   ============================================ */
@media (hover: none) {
    .portfolio-overlay {
        opacity: 1;
    }

    .portfolio-item img {
        filter: grayscale(0%) contrast(1);
    }

    .service-item:hover {
        transform: none;
    }
}

/* ============================================
   🌅 Landscape orientation on small devices
   ============================================ */
@media (max-height: 500px) and (orientation: landscape) {
    .hero {
        height: auto;
        min-height: 100vh;
        padding: 80px 30px 40px;
    }

    .hero-title {
        font-size: clamp(40px, 8vw, 80px);
    }

    .scroll-indicator {
        display: none;
    }
}
